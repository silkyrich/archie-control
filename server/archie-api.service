[Unit]
Description=Archie Control API (home policy engine)
After=network-online.target
Wants=network-online.target

[Service]
User=claude
WorkingDirectory=/home/claude/policy-engine
ExecStart=/usr/bin/python3 /home/claude/policy-engine/api.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
